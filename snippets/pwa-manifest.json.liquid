{%- comment -%}
  pwa-manifest.json.liquid
  Gerado dinamicamente via Liquid para usar dados reais da loja.

  Para ativar:
  1. Crie um template "templates/manifest.json.liquid" (tipo: custom)
     com o conteúdo abaixo usando {% render 'pwa-manifest.json' %}
  2. Ou copie o conteúdo diretamente em templates/manifest.json.liquid

  O link rel="manifest" no theme.liquid aponta para /manifest.json,
  que o Shopify servirá a partir do template manifest.json.liquid.
{%- endcomment -%}
{
  "name": {{ shop.name | json }},
  "short_name": {{ shop.name | truncate: 12, '' | json }},
  "description": {{ shop.description | default: shop.name | json }},
  "start_url": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": {{ settings.color_background | default: '#ffffff' | json }},
  "theme_color": {{ settings.color_background | default: '#ffffff' | json }},
  "lang": {{ request.locale.iso_code | json }},
  "icons": [
    {%- if settings.favicon -%}
    {
      "src": {{ settings.favicon | image_url: width: 192 | json }},
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": {{ settings.favicon | image_url: width: 512 | json }},
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
    {%- else -%}
    {
      "src": "/favicon.ico",
      "sizes": "64x64",
      "type": "image/x-icon"
    }
    {%- endif -%}
  ]
}
